                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isHeldWith"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
